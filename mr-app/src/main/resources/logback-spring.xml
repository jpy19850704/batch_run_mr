<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 统一日志目录：默认 ./logs，可通过 MR_LOG_DIR 覆盖 -->
    <springProperty scope="context" name="LOG_DIR" source="mr.log.dir" defaultValue="./logs"/>

    <property name="JSON_PATTERN" value="{&quot;time&quot;:&quot;%date{yyyy-MM-dd HH:mm:ss.SSS}&quot;,&quot;level&quot;:&quot;%level&quot;,&quot;thread&quot;:&quot;%thread&quot;,&quot;logger&quot;:&quot;%logger{36}&quot;,&quot;traceId&quot;:&quot;%X{traceId:-}&quot;,&quot;requestId&quot;:&quot;%X{requestId:-}&quot;,&quot;clientId&quot;:&quot;%X{clientId:-}&quot;,&quot;userId&quot;:&quot;%X{userId:-}&quot;,&quot;jobId&quot;:&quot;%X{jobId:-}&quot;,&quot;batchId&quot;:&quot;%X{batchId:-}&quot;,&quot;engineCode&quot;:&quot;%X{engineCode:-}&quot;,&quot;message&quot;:&quot;%msg&quot;}%n"/>
    <property name="APP_PATTERN" value="{&quot;time&quot;:&quot;%date{yyyy-MM-dd HH:mm:ss.SSS}&quot;,&quot;level&quot;:&quot;%level&quot;,&quot;thread&quot;:&quot;%thread&quot;,&quot;logger&quot;:&quot;%logger{36}&quot;,&quot;traceId&quot;:&quot;%X{traceId:-}&quot;,&quot;requestId&quot;:&quot;%X{requestId:-}&quot;,&quot;clientId&quot;:&quot;%X{clientId:-}&quot;,&quot;userId&quot;:&quot;%X{userId:-}&quot;,&quot;jobId&quot;:&quot;%X{jobId:-}&quot;,&quot;batchId&quot;:&quot;%X{batchId:-}&quot;,&quot;engineCode&quot;:&quot;%X{engineCode:-}&quot;,&quot;message&quot;:&quot;%msg&quot;}%n%nopex"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${JSON_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- 主问题日志：仅 WARN 及以上，详细日志查看对应模块文件 -->
    <appender name="APP_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/app.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>WARN</level>
        </filter>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${APP_PATTERN}</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/app.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>10GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- 错误日志：仅 ERROR 级，按天+大小滚动，保留 60 天 -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/app-error.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${JSON_PATTERN}</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/app-error.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>60</maxHistory>
            <totalSizeCap>10GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- 定价日志：按天+大小滚动，保留 30 天 -->
    <appender name="PRICING_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/pricing.log</file>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${JSON_PATTERN}</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/pricing.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>10GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- FRTB SA 日志：按天+大小滚动，保留 30 天 -->
    <appender name="FRTBSA_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/frtbsa.log</file>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${JSON_PATTERN}</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/frtbsa.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>10GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- VaR 日志：按天+大小滚动，保留 30 天 -->
    <appender name="VAR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/var.log</file>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${JSON_PATTERN}</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/var.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>10GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- FRTB DRC 日志：按天+大小滚动，保留 30 天 -->
    <appender name="FRTB_DRC_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/frtbdrc.log</file>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <charset>UTF-8</charset>
            <pattern>${JSON_PATTERN}</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/frtbdrc.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>10GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- Scenario 日志：情景生成明细，按天+大小滚动，保留 30 天 -->
    <appender name="SCENARIO_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/scenario.log</file>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <charset>UTF-8</charset>
            <pattern>${JSON_PATTERN}</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/scenario.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>10GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- Job 日志：任务生命周期，按天+大小滚动，保留 30 天 -->
    <appender name="JOB_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/job.log</file>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <charset>UTF-8</charset>
            <pattern>${JSON_PATTERN}</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/job.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>10GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- 结果落库日志：结果表清理、Stream Load、落库状态，按天+大小滚动，保留 30 天 -->
    <appender name="PERSIST_RESULT_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/persist_result.log</file>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <charset>UTF-8</charset>
            <pattern>${JSON_PATTERN}</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/persist_result.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>10GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- BatchRun 日志：按天+大小滚动，保留 30 天 -->
    <appender name="BATCH_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/batch.log</file>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <charset>UTF-8</charset>
            <pattern>${JSON_PATTERN}</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/batch.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>10GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- BatchRun 分类：主链路、任务提交、情景文件 -->
    <logger name="com.zcyh.mr.springboot.service.BatchRunService" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="APP_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
        <appender-ref ref="BATCH_FILE"/>
    </logger>
    <logger name="com.zcyh.mr.springboot.service.BatchCalcSubmitTask" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="APP_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
        <appender-ref ref="BATCH_FILE"/>
    </logger>
    <logger name="com.zcyh.mr.springboot.service.BatchJobService" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="APP_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
        <appender-ref ref="BATCH_FILE"/>
    </logger>
    <logger name="com.zcyh.mr.springboot.service.BatchScenarioFileTask" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="APP_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
        <appender-ref ref="BATCH_FILE"/>
    </logger>
    <!-- Scenario 分类：情景生成引擎、策略、缓存 -->
    <logger name="com.zcyh.mr.scenario" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="APP_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
        <appender-ref ref="SCENARIO_FILE"/>
    </logger>
    <logger name="com.zcyh.mr.springboot.scenario" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="APP_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
        <appender-ref ref="SCENARIO_FILE"/>
    </logger>
    <logger name="com.zcyh.mr.springboot.engine.ScenarioEngineAdapter" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="APP_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
        <appender-ref ref="SCENARIO_FILE"/>
    </logger>
    <logger name="com.zcyh.mr.springboot.service.ScenarioResultCacheService" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="APP_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
        <appender-ref ref="SCENARIO_FILE"/>
    </logger>

    <!-- Job 分类：同步/异步任务入口、调度、取消与查询 -->
    <logger name="com.zcyh.mr.springboot.service.AsyncJobService" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="APP_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
        <appender-ref ref="JOB_FILE"/>
    </logger>
    <logger name="com.zcyh.mr.springboot.api.MrJobController" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="APP_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
        <appender-ref ref="JOB_FILE"/>
    </logger>
    <logger name="com.zcyh.mr.springboot.api.MrEngineController" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="APP_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
        <appender-ref ref="JOB_FILE"/>
    </logger>

    <!-- 结果落库分类：统一查看结果写入链路 -->
    <logger name="com.zcyh.mr.springboot.service.DorisStreamLoadService" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="APP_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
        <appender-ref ref="PERSIST_RESULT_FILE"/>
    </logger>
    <logger name="com.zcyh.mr.springboot.service.PricingResultPersistService" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="APP_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
        <appender-ref ref="PERSIST_RESULT_FILE"/>
    </logger>
    <logger name="com.zcyh.mr.springboot.service.SaccrResultPersistService" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="APP_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
        <appender-ref ref="PERSIST_RESULT_FILE"/>
    </logger>
    <logger name="com.zcyh.mr.springboot.service.ScenarioGeneratedPersistService" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="APP_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
        <appender-ref ref="PERSIST_RESULT_FILE"/>
    </logger>
    <logger name="com.zcyh.mr.springboot.service.ImaCapitalResultPersistService" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="APP_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
        <appender-ref ref="PERSIST_RESULT_FILE"/>
    </logger>
    <logger name="com.zcyh.mr.springboot.service.CalcRuleMetaPersistService" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="APP_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
        <appender-ref ref="PERSIST_RESULT_FILE"/>
    </logger>

    <!-- Pricing 分类：核心定价与产品模型 -->
    <logger name="com.zcyh.mr.calc" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="APP_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
        <appender-ref ref="PRICING_FILE"/>
    </logger>
    <logger name="com.zcyh.mr.product" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="APP_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
        <appender-ref ref="PRICING_FILE"/>
    </logger>

    <!-- FRTB SA 分类：适配器 + 查询/计算/落库 -->
    <logger name="com.zcyh.mr.springboot.engine.FrtbSaEngineAdapter" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="APP_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
        <appender-ref ref="FRTBSA_FILE"/>
    </logger>
    <logger name="com.zcyh.mr.springboot.service.FrtbSbaDbRunnerService" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="APP_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
        <appender-ref ref="FRTBSA_FILE"/>
    </logger>
    <logger name="com.zcyh.mr.springboot.service.FrtbSbaInputQueryService" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="APP_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
        <appender-ref ref="FRTBSA_FILE"/>
    </logger>
    <logger name="com.zcyh.mr.springboot.service.FrtbSbaResultPersistService" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="APP_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
        <appender-ref ref="FRTBSA_FILE"/>
        <appender-ref ref="PERSIST_RESULT_FILE"/>
    </logger>

    <!-- FRTB DRC 分类：适配器 + 查询/计算/汇总/落库 -->
    <logger name="com.zcyh.mr.springboot.engine.FrtbDrcEngineAdapter" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="APP_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
        <appender-ref ref="FRTB_DRC_FILE"/>
    </logger>
    <logger name="com.zcyh.mr.springboot.service.FrtbDrcDbRunnerService" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="APP_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
        <appender-ref ref="FRTB_DRC_FILE"/>
    </logger>
    <logger name="com.zcyh.mr.springboot.service.FrtbDrcInputQueryService" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="APP_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
        <appender-ref ref="FRTB_DRC_FILE"/>
    </logger>
    <logger name="com.zcyh.mr.springboot.service.FrtbDrcSummaryService" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="APP_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
        <appender-ref ref="FRTB_DRC_FILE"/>
    </logger>
    <logger name="com.zcyh.mr.springboot.service.FrtbDrcResultPersistService" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="APP_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
        <appender-ref ref="FRTB_DRC_FILE"/>
        <appender-ref ref="PERSIST_RESULT_FILE"/>
    </logger>

    <!-- VaR 分类：适配器 + 查询/计算/缓存/落库 -->
    <logger name="com.zcyh.mr.springboot.engine.VarEngineAdapter" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="APP_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
        <appender-ref ref="VAR_FILE"/>
    </logger>
    <logger name="com.zcyh.mr.springboot.service.VarDbRunnerService" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="APP_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
        <appender-ref ref="VAR_FILE"/>
    </logger>
    <logger name="com.zcyh.mr.springboot.service.VarInputQueryService" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="APP_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
        <appender-ref ref="VAR_FILE"/>
    </logger>
    <logger name="com.zcyh.mr.springboot.service.VarResultPersistService" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="APP_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
        <appender-ref ref="VAR_FILE"/>
        <appender-ref ref="PERSIST_RESULT_FILE"/>
    </logger>
    <logger name="com.zcyh.mr.springboot.service.VarDetailCacheService" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="APP_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
        <appender-ref ref="VAR_FILE"/>
    </logger>

    <logger name="com.zcyh.mr" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="APP_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </logger>

    <root level="ERROR">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="APP_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </root>
</configuration>
